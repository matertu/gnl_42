{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Compilar Get Next Line",
            "command": "/usr/bin/gcc",
            "args": [
                "-Wall",
                "-Wextra",
                "-Werror",
                "-g3",
                "-D",
                "BUFFER_SIZE=42",
                "${workspaceFolder}/get_next_line.c",
                "${workspaceFolder}/get_next_line_utils.c",
                "${workspaceFolder}/main.c",
                "-o",
                "${workspaceFolder}/a.out"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compilador interno para o debugger com flags da 42."
        }
    ]
}